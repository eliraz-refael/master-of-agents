---
source: crates/moa-agents/tests/plugin.rs
expression: "all.join(\"\\n\")"
---
== .claude-plugin/plugin.json
{
  "name": "moa",
  "version": "1",
  "description": "moa tracks this session (generated; edits are replaced)"
}

== hooks/hooks.json
{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/moa/bin/moa",
            "args": [
              "hook",
              "claude"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/moa/bin/moa",
            "args": [
              "hook",
              "claude"
            ],
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/moa/bin/moa",
            "args": [
              "hook",
              "claude"
            ],
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/moa/bin/moa",
            "args": [
              "hook",
              "claude"
            ],
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/moa/bin/moa",
            "args": [
              "hook",
              "claude"
            ],
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/moa/bin/moa",
            "args": [
              "hook",
              "claude"
            ],
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/moa/bin/moa",
            "args": [
              "hook",
              "claude"
            ],
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/moa/bin/moa",
            "args": [
              "hook",
              "claude"
            ],
            "async": true
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/moa/bin/moa",
            "args": [
              "hook",
              "claude"
            ],
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "/opt/moa/bin/moa",
            "args": [
              "hook",
              "claude"
            ],
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/moa/bin/moa",
            "args": [
              "hook",
              "claude"
            ],
            "async": true
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/opt/moa/bin/moa",
            "args": [
              "hook",
              "claude"
            ],
            "async": true
          }
        ]
      }
    ]
  }
}
