                  }
                },
                "required": [
                  "q"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "Relaunches a session's conversation in a new tab, under the account whose store it\nwas recorded in (C11); one that runs is only brought to the screen. The tab comes to\nthe screen unless `bg`.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "session.resume"
              },
              "params": {
                "type": "object",
                "properties": {
                  "q": {
                    "type": "string"
                  },
                  "bg": {
                    "type": "boolean",
                    "default": false
                  }
                },
                "required": [
                  "q"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "Ends a session and kills its tab, once moa can prove the tab is the session's.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "session.close"
              },
              "params": {
                "type": "object",
                "properties": {
                  "q": {
                    "type": "string"
                  }
                },
                "required": [
                  "q"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "Puts sessions to sleep: their tabs close and they stay resumable. By name (`qs`), or\nevery one idle `idle_ms` that could sleep on its own. A `dry_run` only says which.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "session.sleep"
              },
              "params": {
                "type": "object",
                "properties": {
                  "qs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "default": []
                  },
                  "idle_ms": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "format": "int64",
                    "default": null
                  },
                  "dry_run": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "Takes on the agent running in tab `pane` (`%N`), started outside moa, as a session moa\ndoesn't track: it shows alive or not, and never sleeps on its own. Its conversation is\n`id`, else the one its command names, else the newest it wrote.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "session.adopt"
              },
              "params": {
                "type": "object",
                "properties": {
                  "pane": {
                    "type": "string"
                  },
                  "title": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "default": null
                  },
                  "group": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "default": null
                  },
                  "id": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "default": null
                  }
                },
                "required": [
                  "pane"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "Restarts an adopted session under moa: its tab is closed and its conversation resumed\nin a new tab moa tracks.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "session.restart"
