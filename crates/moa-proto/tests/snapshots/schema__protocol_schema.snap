          "pid",
          "start"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "brain": {
        "type": "string"
      },
      "build": {
        "type": "string"
      },
      "caller": {
        "type": "string"
      },
      "launches": {
        "format": "uint64",
        "minimum": 0,
