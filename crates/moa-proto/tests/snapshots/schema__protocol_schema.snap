          {
            "description": "The front door's handshake: answers `{\"running\": bool}` once moa's terminal server is\nlinked and has its `moa` session, or when there is no server. `tmux` is the\nabsolute path of the tmux program the front door found.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "tmux.ensure"
              },
              "params": {
                "type": "object",
                "properties": {
                  "tmux": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "default": null
                  }
                }
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "A panel says which it is: the tab `pane` (`%N`) it draws in, if any, and the `view`\nit shows, and whether moa `placed` it (it runs with `MOA_NO_AUTOSTART`). The view moa\ntagged the tab with wins over the one asked for; without either it gets the one this\npane last had, else the picture. Answers `{key, view, managed}`: `managed` when the\nview is moa's. `once`: a popup (`moa panel … --once`), which tmux ends when its\nprogram does.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "ui.panel"
              },
              "params": {
                "type": "object",
                "properties": {
                  "pane": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "default": null
                  },
                  "view": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/View"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  },
                  "placed": {
                    "type": "boolean",
                    "default": false
                  },
                  "once": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "Gives the panel in tab `pane` (`%N`) another view: its tag, its frame and its\n`panels` row. Answers `{pane, view}`.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "ui.select_view"
              },
              "params": {
                "type": "object",
                "properties": {
                  "pane": {
                    "type": "string"
                  },
                  "view": {
                    "$ref": "#/$defs/View"
                  }
                },
                "required": [
                  "pane",
                  "view"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "The folder a panel's selection is in, for a terminal opened \"here\".",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "ui.here"
              },
              "params": {
                "type": "object",
                "properties": {
                  "folder": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "default": null
                  },
                  "by_user": {
                    "description": "A key or click in the panel moved its selection there: the user is here. Never\nset for the folder a connect restores, or one that data moved the selection to.",
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "A sheet (the picker or help, linked into your session) is done: its tab is unlinked\nfrom every session but moa's hidden one. Only a sheet's own panel sends it.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "ui.close"
              },
              "params": {
                "$ref": "#/$defs/NoParams"
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "The layouts in `layouts.json` and the presets, the brain's current one marked.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "layout.list"
              },
              "params": {
                "$ref": "#/$defs/NoParams"
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "One layout's JSON.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "layout.show"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "Saves `layout` as `name` in `layouts.json`, once it validates.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "layout.set"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "layout": true
                },
                "required": [
                  "name",
                  "layout"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "Builds layout `name` in the cockpit (the current one when `None`), and makes it the\nbrain's current layout.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "layout.apply"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "default": null
                  }
                }
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "Selects a panel in the cockpit, putting the current layout back first when the panel\nis missing from it. `agent` is the agent spot.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "goto"
              },
              "params": {
                "type": "object",
                "properties": {
                  "panel": {
                    "$ref": "#/$defs/Leaf"
                  }
                },
                "required": [
                  "panel"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "Says `text` to moa. Answered `moa has it` once it is saved; with `wait`, with moa's\nanswer once its turn ends. Refused while moa is answering, or still starting.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "console.prompt"
              },
              "params": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "wait": {
                    "type": "boolean",
                    "default": false
                  }
                },
                "required": [
                  "text"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "Cancels moa's turn under way.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "console.cancel"
              },
              "params": {
                "$ref": "#/$defs/NoParams"
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "The `n` feed rows before id `before`, oldest first, from every thread: what the\nconsole pages back through. Answered by the daemon from the store, not by the core.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "console.page"
              },
              "params": {
                "type": "object",
                "properties": {
                  "before": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "n": {
                    "type": "integer",
                    "format": "uint16",
                    "minimum": 0,
                    "maximum": 65535,
                    "default": 100
                  }
                },
                "required": [
                  "before"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "The next prompt starts a new thread, even the same day.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "console.new"
              },
              "params": {
                "$ref": "#/$defs/NoParams"
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "A `/command` line typed in the console, run as the op it names with no turn of moa's\n(`moa_core::console`). The reply is that op's reply.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "console.command"
              },
              "params": {
                "type": "object",
                "properties": {
                  "line": {
                    "type": "string"
                  }
                },
                "required": [
                  "line"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "Answers moa's agent's permission request `id` (its `feed` row; the oldest waiting when\n`None`) with its option of the kind `answer` names.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "console.permission"
              },
              "params": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "format": "int64",
                    "default": null
                  },
                  "answer": {
                    "$ref": "#/$defs/PermAnswer"
                  }
                },
                "required": [
                  "answer"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "`/auto`: whether moa reads the session reports on its own, with wake-ups. `None` flips\nit.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "console.auto"
              },
              "params": {
                "type": "object",
                "properties": {
                  "on": {
                    "type": [
                      "boolean",
                      "null"
                    ],
                    "default": null
                  }
                }
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "`/sleep`: how long an idle session waits before it goes to sleep: `on` (moa.toml's),\n`off` (never) or a number of hours. `None` says the wait.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "console.sleep_after"
              },
              "params": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "default": null
                  }
                }
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "`/account`: switches moa's agent to account `name` with the next prompt; only you can.\n`None` says which account moa is on, and the others it can run on.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "console.account"
              },
              "params": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "default": null
                  }
                }
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "Sets the console's button bar: `/command` lines, as moa's list (`user: false`, from\n`moactl bar`) or yours (`user: true`, from `/bar`), which wins. No commands clears it.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "bar.set"
              },
              "params": {
                "type": "object",
                "properties": {
                  "commands": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "user": {
                    "type": "boolean",
                    "default": false
                  }
                },
                "required": [
                  "commands"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "The agents the caller can ask: moa, then every live session but the caller's own.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "peers"
              },
              "params": {
                "$ref": "#/$defs/NoParams"
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "Asks agent `to` (a session's name, or `moa`) `text`, and waits up to `timeout_s`\nseconds for the answer. Only a session or moa can ask.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "ask"
              },
              "params": {
                "type": "object",
                "properties": {
                  "to": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  },
                  "timeout_s": {
                    "type": "integer",
                    "format": "int64",
                    "default": 540
                  }
                },
                "required": [
                  "to",
                  "text"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "Waits again, up to `timeout_s` seconds, for the answer to ask `id`.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "reply"
              },
              "params": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "timeout_s": {
                    "type": "integer",
                    "format": "int64",
                    "default": 540
                  }
                },
                "required": [
                  "id"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "The caller's recent asks, from it or to it (every ask for a caller that is neither a\nsession nor moa).",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "asks"
              },
              "params": {
                "$ref": "#/$defs/NoParams"
              }
            },
            "required": [
              "method",
              "params"
            ]
          }
        ]
      },
      "TaskAdd": {
        "description": "`task add`'s arguments, all the user's raw text.",
        "type": "object",
        "properties": {
          "project": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "today": {
            "type": "boolean",
            "default": false
          },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "blocked_on": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "who": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "due": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "session": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "priority": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "project",
          "title"
        ]
      },
      "TaskSet": {
        "description": "`task set`'s arguments. `Some(\"\")` clears `due`, `priority`, `session`, `note` and\n`blocked_on`.",
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "who": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "due": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "priority": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "session": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "note": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "blocked_on": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          },
          "today": {
            "type": "boolean",
            "default": false
          },
          "not_today": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "id"
        ]
      },
      "Answer": {
        "description": "How a suggestion is answered.",
        "type": "string",
        "enum": [
          "yes",
          "no",
          "later"
        ]
      },
      "View": {
        "description": "What a panel shows.",
        "type": "string",
        "enum": [
          "console",
          "tree",
          "plan",
          "status",
          "today",
          "activity",
          "projects",
          "picture",
          "picker",
          "terms",
          "empty-slot",
          "help",
          "setup"
        ]
      },
      "Leaf": {
        "type": "string",
        "enum": [
          "console",
          "tree",
          "today",
          "activity",
          "projects",
          "plan",
          "status",
          "picture",
          "agent"
        ]
      },
      "PermAnswer": {
        "description": "How a permission request of moa's agent is answered: by the kind of option it offers,\nnever its place.",
        "oneOf": [
          {
            "description": "Its `allow_once` option.",
            "type": "string",
            "const": "once"
          },
          {
            "description": "Its `allow_always` option.",
            "type": "string",
            "const": "always"
          },
          {
            "description": "Its `reject_once` option, else its `reject_always`.",
            "type": "string",
            "const": "no"
          }
        ]
      }
    }
  },
  "HelloOk": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "HelloOk",
    "type": "object",
    "properties": {
      "brain": {
        "type": "string"
      },
      "build": {
        "type": "string"
      },
      "rev": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      },
      "matched": {
        "type": "boolean"
      },
      "pid": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      },
      "exe": {
        "description": "The daemon's program: the path it runs, watches and upgrades into (`MOA_EXE`). A\ndaemon from before live updates sends none.",
        "type": [
          "string",
          "null"
        ],
        "default": null
      }
    },
    "required": [
      "brain",
      "build",
      "rev",
      "matched",
      "pid"
    ]
  },
  "StatusOk": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "StatusOk",
    "type": "object",
    "properties": {
      "brain": {
        "type": "string"
      },
      "build": {
        "type": "string"
      },
      "pid": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      },
      "launches": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      },
      "sessions": {
        "type": "object",
        "additionalProperties": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "caller": {
        "type": "string"
      },
      "tmux": {
        "description": "The terminal server, while linked.",
        "anyOf": [
          {
            "$ref": "#/$defs/TmuxLinkData"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "tmux_restarts": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0,
        "default": 0
      },
      "panel_starts": {
        "description": "How many panels moa started or restarted while this daemon ran.",
        "type": "integer",
        "format": "uint32",
        "minimum": 0,
        "default": 0
      },
      "upgrade": {
        "description": "`waiting for moa's turn` while an upgrade waits; `null` otherwise.",
        "type": [
          "string",
          "null"
        ],
        "default": null
      }
    },
    "required": [
      "brain",
      "build",
      "pid",
      "launches",
      "sessions",
      "caller"
    ],
    "$defs": {
      "TmuxLinkData": {
        "description": "The terminal server the daemon is linked to: its tmux version and generation.",
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "pid": {
            "type": "integer",
            "format": "int64"
          },
          "start": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "version",
          "pid",
          "start"
        ]
      }
    }
  },
  "UpgradeOk": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "UpgradeOk",
    "description": "`upgrade`'s reply. A daemon from before live updates answers `{}` and stops instead: a\nreply this can't be read from (no `upgrading`) is that.",
    "type": "object",
    "properties": {
      "upgrading": {
        "description": "The daemon upgrades in place, once moa is between turns; its pid stays.",
        "type": "boolean"
      },
      "waiting_for_moa": {
        "description": "The upgrade waits for moa's turn to end.",
        "type": "boolean",
        "default": false
      },
      "exe": {
        "description": "When it doesn't upgrade: the program that runs this brain.",
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "upgrading"
    ]
  },
  "SnapshotMsg": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "SnapshotMsg",
    "description": "The full rows of the subscribed topics at one rev.",
    "type": "object",
    "properties": {
      "rev": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      },
      "topics": {
        "type": "object",
        "properties": {
          "activity": {
            "type": "array",
            "items": true
          },
          "asks": {
            "type": "array",
            "items": true
          },
          "brain": {
            "type": "array",
            "items": true
          },
          "feed": {
            "type": "array",
            "items": true
          },
          "groups": {
            "type": "array",
            "items": true
          },
          "layouts": {
            "type": "array",
            "items": true
          },
          "panels": {
            "type": "array",
            "items": true
          },
          "projects": {
            "type": "array",
            "items": true
          },
          "sessions": {
            "type": "array",
            "items": true
          },
          "status": {
            "type": "array",
            "items": true
          },
          "suggestions": {
            "type": "array",
            "items": true
          },
          "tasks": {
            "type": "array",
            "items": true
          },
          "terms": {
            "type": "array",
            "items": true
          }
        },
        "additionalProperties": false
      }
    },
    "required": [
      "rev",
      "topics"
    ]
  },
  "Patch": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Patch",
    "description": "What changed since the subscriber's last rev: rows to insert or replace (each carries its\n`\"key\"`) and keys to remove, by topic. A topic that did not change is absent.",
    "type": "object",
    "properties": {
      "rev": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      },
      "upsert": {
        "type": "object",
        "properties": {
          "activity": {
            "type": "array",
            "items": true
          },
          "asks": {
            "type": "array",
            "items": true
          },
          "brain": {
            "type": "array",
            "items": true
