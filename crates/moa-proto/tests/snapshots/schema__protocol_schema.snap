---
source: crates/moa-proto/tests/schema.rs
expression: all
---
{
  "Call": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Call",
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "method": {
            "const": "hello"
          },
          "params": {
            "$ref": "#/$defs/Hello"
          }
        },
        "required": [
          "method",
          "params"
        ]
      },
      {
        "type": "object",
        "properties": {
          "method": {
            "const": "status"
          },
          "params": {
            "$ref": "#/$defs/NoParams"
          }
        },
        "required": [
          "method"
        ]
      },
      {
        "type": "object",
        "properties": {
          "method": {
            "const": "shutdown"
          },
          "params": {
            "$ref": "#/$defs/NoParams"
          }
        },
        "required": [
          "method"
        ]
      },
      {
        "type": "object",
        "properties": {
          "method": {
            "const": "upgrade"
          },
          "params": {
            "$ref": "#/$defs/UpgradeParams"
          }
        },
        "required": [
          "method"
        ]
      },
      {
        "type": "object",
        "properties": {
          "method": {
            "const": "subscribe"
          },
          "params": {
            "$ref": "#/$defs/Subscribe"
          }
        },
        "required": [
          "method",
          "params"
        ]
      },
      {
        "$ref": "#/$defs/Op"
      }
    ],
    "$defs": {
      "NoParams": {
        "type": [
          "object",
          "null"
        ],
        "properties": {},
        "additionalProperties": false
      },
      "Hello": {
        "description": "A client's greeting: who it is, which build, and what it says about its caller.",
        "type": "object",
        "properties": {
          "client": {
            "type": "string"
          },
          "build": {
            "type": "string"
          },
          "caller": {
            "$ref": "#/$defs/CallerInfo"
          }
        },
        "required": [
          "client",
          "build",
          "caller"
        ]
      },
      "CallerInfo": {
        "description": "What a caller says about itself (the hook environment).",
        "type": "object",
        "properties": {
          "moa_session": {
            "type": [
              "string",
              "null"
            ]
          },
          "claude_session": {
            "type": [
              "string",
              "null"
            ]
          },
          "cwd": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "UpgradeParams": {
        "description": "`upgrade`'s params. An old client's bare `upgrade` is `if_stale: false`.",
        "type": "object",
        "properties": {
          "if_stale": {
            "description": "Upgrade only when the daemon's program is no longer the build it runs; otherwise the\nreply names that program.",
            "type": "boolean",
            "default": false
          }
        }
      },
      "Subscribe": {
        "description": "Which topics a connection follows. `since` is the rev the client already holds.",
        "type": "object",
        "properties": {
          "topics": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Topic"
            }
          },
          "since": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint64",
            "minimum": 0,
            "default": null
          }
        },
        "required": [
          "topics"
        ]
      },
      "Topic": {
        "description": "A named set of rows a view can subscribe to.",
        "type": "string",
        "enum": [
          "sessions",
          "groups",
          "projects",
          "tasks",
          "suggestions",
          "asks",
          "activity",
          "status",
          "brain",
          "panels",
          "layouts",
          "terms",
          "feed"
        ]
      },
      "Op": {
        "description": "One verb with its arguments. On the wire: `{\"method\": \"group.add\", \"params\": {...}}`.",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "group.add"
              },
              "params": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "group.rename"
              },
              "params": {
                "type": "object",
                "properties": {
                  "old": {
                    "type": "string"
                  },
                  "new": {
                    "type": "string"
                  }
                },
                "required": [
                  "old",
                  "new"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "type": "object",
