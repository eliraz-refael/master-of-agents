---
source: crates/moa-proto/tests/schema.rs
expression: all
---
{
  "Call": {
    "$defs": {
      "Answer": {
        "description": "How a suggestion is answered.",
        "enum": [
          "yes",
          "no",
          "later"
        ],
        "type": "string"
      },
      "CallerInfo": {
        "description": "What a caller says about itself (the hook environment).",
        "properties": {
          "claude_session": {
            "type": [
              "string",
              "null"
            ]
          },
          "cwd": {
            "type": [
              "string",
              "null"
            ]
          },
          "moa_session": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "Hello": {
        "description": "A client's greeting: who it is, which build, and what it says about its caller.",
        "properties": {
          "build": {
            "type": "string"
          },
          "caller": {
            "$ref": "#/$defs/CallerInfo"
          },
          "client": {
            "type": "string"
          }
        },
        "required": [
          "client",
          "build",
          "caller"
        ],
        "type": "object"
      },
      "Leaf": {
        "enum": [
          "console",
          "tree",
          "today",
          "activity",
          "projects",
          "plan",
          "status",
          "picture",
          "agent"
        ],
        "type": "string"
      },
      "NoParams": {
        "additionalProperties": false,
        "properties": {},
        "type": [
          "object",
          "null"
        ]
      },
      "Op": {
        "description": "One verb with its arguments. On the wire: `{\"method\": \"group.add\", \"params\": {...}}`.",
        "oneOf": [
          {
            "properties": {
              "method": {
                "const": "group.add",
                "type": "string"
              },
              "params": {
                "properties": {
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ],
                "type": "object"
              }
            },
            "required": [
              "method",
              "params"
            ],
            "type": "object"
          },
          {
            "properties": {
              "method": {
                "const": "group.rename",
                "type": "string"
              },
              "params": {
                "properties": {
                  "new": {
                    "type": "string"
                  },
                  "old": {
                    "type": "string"
                  }
                },
                "required": [
                  "old",
                  "new"
                ],
                "type": "object"
              }
            },
            "required": [
              "method",
              "params"
            ],
            "type": "object"
          },
          {
            "properties": {
              "method": {
                "const": "group.rm",
                "type": "string"
              },
              "params": {
                "properties": {
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ],
                "type": "object"
              }
            },
            "required": [
              "method",
              "params"
            ],
            "type": "object"
          },
          {
            "description": "Folds or unfolds one tree path. Saved as one value; never a group.",
            "properties": {
              "method": {
                "const": "group.fold",
                "type": "string"
              },
              "params": {
                "properties": {
                  "collapsed": {
                    "type": "boolean"
                  },
                  "path": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "collapsed"
                ],
                "type": "object"
              }
            },
            "required": [
              "method",
              "params"
            ],
            "type": "object"
          },
          {
            "properties": {
              "method": {
                "const": "session.ls",
                "type": "string"
              },
              "params": {
                "properties": {
                  "all": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "type": "object"
              }
            },
            "required": [
              "method",
              "params"
            ],
            "type": "object"
          },
          {
            "properties": {
              "method": {
                "const": "session.set",
                "type": "string"
              },
              "params": {
                "properties": {
                  "group": {
                    "default": null,
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "q": {
                    "type": "string"
                  },
                  "title": {
                    "default": null,
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "q"
                ],
                "type": "object"
              }
            },
            "required": [
              "method",
              "params"
            ],
            "type": "object"
          },
          {
            "properties": {
              "method": {
                "const": "session.archive",
                "type": "string"
              },
              "params": {
                "properties": {
                  "qs": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "qs"
                ],
                "type": "object"
              }
            },
            "required": [
              "method",
              "params"
            ],
            "type": "object"
          },
          {
            "properties": {
              "method": {
                "const": "session.find",
                "type": "string"
              },
              "params": {
                "properties": {
                  "q": {
                    "type": "string"
                  }
                },
                "required": [
                  "q"
                ],
                "type": "object"
              }
            },
            "required": [
              "method",
              "params"
            ],
            "type": "object"
          },
          {
            "description": "A fresh session in a new tab of moa's terminal. `path` is absolute; the reply comes\nonce tmux says which pane the tab has. The tab comes to the screen unless `bg`.",
            "properties": {
              "method": {
                "const": "session.open",
                "type": "string"
              },
              "params": {
                "properties": {
                  "account": {
                    "default": null,
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "bg": {
                    "default": false,
                    "type": "boolean"
                  },
                  "group": {
                    "default": null,
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "path": {
                    "type": "string"
                  },
                  "prompt": {
                    "default": null,
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "title": {
                    "default": null,
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "path"
                ],
                "type": "object"
              }
            },
            "required": [
              "method",
              "params"
            ],
            "type": "object"
          },
          {
            "description": "Brings a session's tab to the screen. A write: a session not running is resumed.",
            "properties": {
              "method": {
                "const": "session.focus",
                "type": "string"
              },
              "params": {
                "properties": {
                  "q": {
                    "type": "string"
                  }
                },
                "required": [
                  "q"
                ],
                "type": "object"
              }
            },
            "required": [
              "method",
              "params"
            ],
            "type": "object"
          },
          {
            "description": "Relaunches a session's conversation in a new tab, under the account whose store it\nwas recorded in (C11); one that runs is only brought to the screen. The tab comes to\nthe screen unless `bg`.",
            "properties": {
              "method": {
                "const": "session.resume",
                "type": "string"
              },
              "params": {
                "properties": {
                  "bg": {
                    "default": false,
                    "type": "boolean"
                  },
                  "q": {
                    "type": "string"
                  }
                },
                "required": [
                  "q"
                ],
                "type": "object"
              }
            },
            "required": [
              "method",
              "params"
            ],
            "type": "object"
          },
          {
            "description": "Ends a session and kills its tab, once moa can prove the tab is the session's.",
            "properties": {
              "method": {
                "const": "session.close",
                "type": "string"
              },
              "params": {
                "properties": {
                  "q": {
                    "type": "string"
                  }
                },
                "required": [
                  "q"
                ],
                "type": "object"
              }
            },
            "required": [
              "method",
              "params"
            ],
            "type": "object"
          },
          {
            "description": "Puts sessions to sleep: their tabs close and they stay resumable. By name (`qs`), or\nevery one idle `idle_ms` that could sleep on its own. A `dry_run` only says which.",
            "properties": {
              "method": {
                "const": "session.sleep",
                "type": "string"
              },
              "params": {
                "properties": {
                  "dry_run": {
                    "default": false,
                    "type": "boolean"
                  },
                  "idle_ms": {
                    "default": null,
                    "format": "int64",
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "qs": {
                    "default": [],
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              }
            },
            "required": [
              "method",
              "params"
            ],
            "type": "object"
          },
          {
            "description": "Takes on the agent running in tab `pane` (`%N`), started outside moa, as a session moa\ndoesn't track: it shows alive or not, and never sleeps on its own. Its conversation is\n`id`, else the one its command names, else the newest it wrote.",
            "properties": {
              "method": {
                "const": "session.adopt",
                "type": "string"
              },
              "params": {
                "properties": {
                  "group": {
                    "default": null,
                    "type": [
