                    ],
                    "default": null
                  },
                  "bg": {
                    "type": "boolean",
                    "default": false
                  }
                },
                "required": [
                  "path"
                ]
              }
            },
            "required": [
              "method",
              "params"
            ]
          },
          {
            "description": "Brings a session's tab to the screen. A write: a session not running is resumed.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "session.focus"
              },
              "params": {
                "type": "object",
                "properties": {
