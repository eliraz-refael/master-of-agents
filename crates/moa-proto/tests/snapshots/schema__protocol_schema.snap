              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "rev": {
        "format": "uint64",
        "minimum": 0,
        "type": "integer"
      },
      "upsert": {
        "additionalProperties": false,
        "properties": {
          "activity": {
            "items": true,
            "type": "array"
          },
          "asks": {
            "items": true,
            "type": "array"
          },
          "brain": {
            "items": true,
