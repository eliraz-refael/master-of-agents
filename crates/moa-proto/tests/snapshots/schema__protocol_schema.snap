                    "default": null,
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "pane": {
                    "type": "string"
                  },
                  "title": {
                    "default": null,
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "pane"
                ],
                "type": "object"
              }
            },
            "required": [
              "method",
              "params"
            ],
            "type": "object"
          },
          {
            "description": "Restarts an adopted session under moa: its tab is closed and its conversation resumed\nin a new tab moa tracks.",
            "properties": {
              "method": {
                "const": "session.restart",
                "type": "string"
              },
              "params": {
                "properties": {
