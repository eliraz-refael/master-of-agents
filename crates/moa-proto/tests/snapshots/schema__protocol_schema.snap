            ]
          },
          {
            "description": "A fresh session in a new tab of moa's terminal. `path` is absolute; the reply comes\nonce tmux says which pane the tab has. The tab comes to the screen unless `bg`.",
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "const": "session.open"
              },
              "params": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "account": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "default": null
                  },
                  "title": {
                    "type": [
                      "string",
