---
source: crates/moa-tmux/tests/conf.rs
expression: "moa_tmux(\"default\", true)"
---
# Generated by moa. Edits are overwritten: put your own settings in ~/.tmux.conf, which
# loads first.
# moa sources this file over its control connection on every connect, so it holds no hooks
# (moa sets those itself) and nothing that waits.
# Rule: no #(shell) segments and nothing driven by status-interval scripts. Only built-in
# formats and user options.

# --- Terminal: true colour and keys ---------------------------------------------------
set -s  default-terminal "tmux-256color"
set -s  terminal-features[20] "xterm-ghostty:RGB:extkeys:focus:clipboard:hyperlinks"
set -s  terminal-features[21] "xterm-kitty:RGB"
set -s  terminal-features[22] "alacritty:RGB"
set -s  terminal-features[23] "wezterm:RGB"
set -s  terminal-features[24] "foot*:RGB"
set -s  escape-time 10          # near-zero Esc delay for TUIs (0 can leak DA replies on attach)
set -s  focus-events on         # agents get focus in/out
set -s  extended-keys on        # Shift+Enter etc. reach the agents
set -g  mouse on               # panels take clicks, hover and the wheel; [ui] mouse = false in moa.toml leaves it to you

# --- Windows and history -------------------------------------------------------
set -g  base-index 1            # agent windows start at 1
set -g  renumber-windows on     # no gaps after closing an agent window
set -g  history-limit 50000     # agent transcripts are long; applies to new panes
set -g  display-time 2000
set -g  set-titles on           # the terminal's tab/title shows the current agent
set -g  set-titles-string "moa · #W"

# --- Bells: an agent ringing the bell shows up in the window list --------------
set -g  monitor-activity off    # agents spin constantly; activity would always be lit
set -g  monitor-bell on
set -g  bell-action any
set -g  visual-bell off

# --- Palette (dark; status bg follows the terminal background) -----------------
#   text #d8dee9  bright #eceff4  dim #8c9ab3  surface #3b4252  line #4c566a
#   blue #88c0d0  green #a3be8c  yellow #ebcb8b  orange #d08770  red #d57780

# --- Status line -----------------------------------------------------------------
# Two lines: a blank one for breathing room under the panes, then the bar. Pills are
# rounded with the Nerd Font half circles … (the terminal needs the symbols).
set -g  status 2
set -g  status-format[0] ""
set -g  status-format[1] '#[align=left range=left #{E:status-left-style}]#[push-default]#{T;=/#{status-left-length}:status-left}#[pop-default]#[norange default]#[list=on align=#{status-justify}]#[list=left-marker]<#[list=right-marker]>#[list=on]#{W:#[range=window|#{window_index} #{E:window-status-style}#{?#{&&:#{window_last_flag},#{!=:#{E:window-status-last-style},default}}, #{E:window-status-last-style},}#{?#{&&:#{window_bell_flag},#{!=:#{E:window-status-bell-style},default}}, #{E:window-status-bell-style},#{?#{&&:#{||:#{window_activity_flag},#{window_silence_flag}},#{!=:#{E:window-status-activity-style},default}}, #{E:window-status-activity-style},}}]#[push-default]#{T:window-status-format}#[pop-default]#[norange default]#{?loop_last_flag,,#{E:window-status-separator}},#[range=window|#{window_index} list=focus #{?#{!=:#{E:window-status-current-style},default},#{E:window-status-current-style},#{E:window-status-style}}#{?#{&&:#{window_last_flag},#{!=:#{E:window-status-last-style},default}}, #{E:window-status-last-style},}#{?#{&&:#{window_bell_flag},#{!=:#{E:window-status-bell-style},default}}, #{E:window-status-bell-style},#{?#{&&:#{||:#{window_activity_flag},#{window_silence_flag}},#{!=:#{E:window-status-activity-style},default}}, #{E:window-status-activity-style},}}]#[push-default]#{T:window-status-current-format}#[pop-default]#[norange list=on default]#{?loop_last_flag,,#{E:window-status-separator}}}#[nolist align=right range=right #{E:status-right-style}]#[push-default]#{T;=/#{status-right-length}:status-right}#[pop-default]#[norange default]'
set -g  status-position bottom
set -g  status-justify left
set -g  status-interval 0       # moa writes @moa_clock itself, only while someone is looking
set -g  status-style "bg=default,fg=#d8dee9"

# Left: the "◆ moa" pill. Blue normally, orange in the Ctrl-a key mode (its keys follow
# in a grey pill), yellow in copy mode. Then where you are: the current window as a
# raised pill with its agent's state (the cockpit reads "cockpit"). It lives here rather
# than in the window list so it stays put, first, however many agents wait on you.
set -g  status-left-length 160
set -g  status-left "#{?#{==:#{client_key_table},moa},#[fg=#d08770]#[bg=#d08770 fg=#2e3440 bold] ◆ moa #[bg=default fg=#d08770 nobold] #[fg=#3b4252]#[bg=#3b4252 fg=#eceff4] ←↑↓→ move · / find · c console · t sessions · p big picture · g agent · $ terminal · z zoom · Space menu · ? help #[bg=default fg=#3b4252]   ,#{?client_prefix,#[fg=#d08770]#[bg=#d08770],#{?pane_in_mode,#[fg=#ebcb8b]#[bg=#ebcb8b],#[fg=#88c0d0]#[bg=#88c0d0]}}#[fg=#2e3440 bold] ◆ moa #[bg=default nobold]#{?client_prefix,#[fg=#d08770],#{?pane_in_mode,#[fg=#ebcb8b],#[fg=#88c0d0]}} #[fg=#8c9ab3] ^a keys  #[fg=#3b4252]#[bg=#3b4252]#{?#{==:#{@moa_state},waiting},#[fg=#ebcb8b]⚠ ,#{?#{==:#{@moa_state},question},#[fg=#d08770]? ,#{?#{==:#{@moa_state},done},#[fg=#a3be8c]✓ ,#{?#{==:#{@moa_state},working},#[fg=#88c0d0]◐ ,#{?#{==:#{@moa_state},idle},#[fg=#8c9ab3]● ,#{?#{==:#{@moa_state},failed},#[fg=#d57780]✗ ,}}}}}}#[fg=#eceff4 bold]#{?#{==:#{window_name},moa},▦ cockpit,#W}#{?window_zoomed_flag,#[fg=#88c0d0] ⤢,}#[bg=default fg=#3b4252 nobold]  }"

# Window list: scales to dozens of agents by not listing them. Only agents waiting on
# you (⚠, a permission prompt) or asking you something (?) are named, since those are
# the urgent ones; the current window is on the left, everything else is a count on the
# right, and Ctrl-a / finds any session by name.
# @moa_state is the status state of the window's agent, set by moa.
# Other windows expand to nothing, so the separator is empty and spacing is in the formats.
set -g  window-status-separator ""
set -g  window-status-format         "#{?#{==:#{@moa_state},waiting}, #[fg=#ebcb8b]⚠ #{=/18/…:window_name} ,#{?#{==:#{@moa_state},question}, #[fg=#d08770]? #{=/18/…:window_name} ,}}"
set -g  window-status-current-format ""
set -g  window-status-style          "default"
set -g  window-status-current-style  "default"
set -g  window-status-last-style     "default"
set -g  window-status-bell-style     "fg=#d57780,bold"
set -g  window-status-activity-style "fg=#ebcb8b"

# Right: how many agents are in each state (@moa_status, coloured per state by moa) in a
# grey pill; then the date and the time (@moa_clock, written by moa at each minute).
set -g  status-right-length 120
set -g  status-right "#{?#{@moa_status},#[fg=#3b4252]#[bg=#3b4252] #{@moa_status} #[bg=default fg=#3b4252]  ,}#[fg=#3b4252]#[bg=#3b4252 fg=#8c9ab3] %a %d %b #[fg=#eceff4 bold]#{@moa_clock} #[bg=default fg=#3b4252 nobold] "

# --- Panes: gutters, not lines ---------------------------------------------------
# tmux can't round its pane borders, so they're blank gutters (spacing between panes)
# and moa's own panels draw rounded frames inside their panes, lit while focused.
# Panes without their own frame (agents, the empty agent spot) get a title pill in the
# gutter above them: @moa_label, or the window's name.
# tmux 3.4 has no blank borders (`spaces` arrived after 3.4), so there the gutters are thin
# lines.
if -F '#{||:#{m:3.4*,#{version}},#{m:next-3.4*,#{version}}}' { set -g pane-border-lines single } { set -g pane-border-lines spaces }
set -g  pane-border-indicators off
set -g  pane-border-status top
set -g  pane-border-style        "fg=#4c566a"
set -g  pane-active-border-style "fg=#88c0d0"
set -g  pane-border-format "#{?#{@moa_framed},,#{?pane_active,#[fg=#88c0d0]#[fg=#2e3440 bg=#88c0d0 bold],#[fg=#3b4252]#[fg=#eceff4 bg=#3b4252]} #{?#{@moa_label},#{@moa_label},● #W} #{?pane_active,#[fg=#88c0d0 bg=default nobold],#[fg=#3b4252 bg=default]}#[default]}#{?window_zoomed_flag,#[fg=#8c9ab3]  zoomed · Ctrl-a z,}"

# --- Messages, menus, popups ------------------------------------------------------
set -g  message-style            "bg=#3b4252,fg=#eceff4"
set -g  message-command-style    "bg=#3b4252,fg=#88c0d0"
set -g  mode-style               "bg=#5e81ac,fg=#eceff4"
set -g  menu-style               "bg=#2e3440,fg=#d8dee9"
set -g  menu-selected-style      "bg=#5e81ac,fg=#eceff4"
set -g  menu-border-style        "fg=#88c0d0"
set -g  menu-border-lines rounded
set -g  popup-style              "bg=#2e3440,fg=#eceff4"
set -g  popup-border-style       "fg=#88c0d0"
set -g  popup-border-lines rounded

# --- Keys --------------------------------------------------------------------------
# Everything starts from Ctrl-a (no tmux prefix), and the status line lists the keys
# while Ctrl-a is held. Ctrl-Space is taken by macOS.
# Ctrl-a then an arrow moves to the pane that way (arrows repeat without Ctrl-a for
# a moment; h j k l don't, so typing right after a move isn't eaten). Ctrl-a twice,
# or Ctrl-a Space, opens the full menu. Ctrl-a a sends a literal Ctrl-a to the app
# (screen's convention).
# Keys that need moa tell it through its control connection (@moa_ctl names it); without
# moa running they say so. The rest are plain tmux.
set -g  repeat-time 700
# tmux checks its prefix before any other key, so a prefix of Ctrl-a (screen's, set in
# your own file) would take every moa key: it goes back to Ctrl-b. Any other prefix stays.
if -F "#{==:#{prefix},C-a}"  "set -g prefix C-b"
if -F "#{==:#{prefix2},C-a}" "set -g prefix2 None"
bind -n C-a switch-client -T moa
bind -T moa c       if -F '#{@moa_ctl}' { run -C "display-message -c '#{@moa_ctl}' 'moa:key console ##{pane_id} ##{session_id} ##{client_name}'" } { display-message -d 4000 "moa isn't running: run moa" }
bind -T moa t       if -F '#{@moa_ctl}' { run -C "display-message -c '#{@moa_ctl}' 'moa:key tree ##{pane_id} ##{session_id} ##{client_name}'" } { display-message -d 4000 "moa isn't running: run moa" }
bind -T moa p       if -F '#{@moa_ctl}' { run -C "display-message -c '#{@moa_ctl}' 'moa:key plan ##{pane_id} ##{session_id} ##{client_name}'" } { display-message -d 4000 "moa isn't running: run moa" }
bind -T moa g       if -F '#{@moa_ctl}' { run -C "display-message -c '#{@moa_ctl}' 'moa:key agent ##{pane_id} ##{session_id} ##{client_name}'" } { display-message -d 4000 "moa isn't running: run moa" }
bind -T moa /       if -F '#{@moa_ctl}' { run -C "display-message -c '#{@moa_ctl}' 'moa:key find ##{pane_id} ##{session_id} ##{client_name}'" } { display-message -d 4000 "moa isn't running: run moa" }
bind -T moa s       if -F '#{@moa_ctl}' { run -C "display-message -c '#{@moa_ctl}' 'moa:key find-other ##{pane_id} ##{session_id} ##{client_name}'" } { display-message -d 4000 "moa isn't running: run moa" }
bind -T moa n       if -F '#{@moa_ctl}' { run -C "display-message -c '#{@moa_ctl}' 'moa:key new ##{pane_id} ##{session_id} ##{client_name}'" } { display-message -d 4000 "moa isn't running: run moa" }
bind -T moa '$'     if -F '#{@moa_ctl}' { run -C "display-message -c '#{@moa_ctl}' 'moa:key terminal ##{pane_id} ##{session_id} ##{client_name}'" } { display-message -d 4000 "moa isn't running: run moa" }
bind -T moa 1       if -F '#{@moa_ctl}' { run -C "display-message -c '#{@moa_ctl}' 'moa:key layout-1 ##{pane_id} ##{session_id} ##{client_name}'" } { display-message -d 4000 "moa isn't running: run moa" }
bind -T moa 2       if -F '#{@moa_ctl}' { run -C "display-message -c '#{@moa_ctl}' 'moa:key layout-2 ##{pane_id} ##{session_id} ##{client_name}'" } { display-message -d 4000 "moa isn't running: run moa" }
bind -T moa 3       if -F '#{@moa_ctl}' { run -C "display-message -c '#{@moa_ctl}' 'moa:key layout-3 ##{pane_id} ##{session_id} ##{client_name}'" } { display-message -d 4000 "moa isn't running: run moa" }
bind -T moa 4       if -F '#{@moa_ctl}' { run -C "display-message -c '#{@moa_ctl}' 'moa:key layout-4 ##{pane_id} ##{session_id} ##{client_name}'" } { display-message -d 4000 "moa isn't running: run moa" }
bind -T moa r       if -F '#{@moa_ctl}' { run -C "display-message -c '#{@moa_ctl}' 'moa:key repair ##{pane_id} ##{session_id} ##{client_name}'" } { display-message -d 4000 "moa isn't running: run moa" }
bind -T moa '?'     if -F '#{@moa_ctl}' { run -C "display-message -c '#{@moa_ctl}' 'moa:key help ##{pane_id} ##{session_id} ##{client_name}'" } { display-message -d 4000 "moa isn't running: run moa" }
# | and -: split the pane you're on (a shell beside or below an agent, in its folder);
# its border says it's a shell; `exit` closes it. Not in the cockpit, where panes belong to the layout.
bind -T moa '|'     if -F "#{==:#{window_name},moa}" "display 'split an agent or terminal tab; the cockpit is a layout'" "split-window -h -c '#{pane_current_path}' ; set -p @moa_label '⌨ shell'"
bind -T moa -       if -F "#{==:#{window_name},moa}" "display 'split an agent or terminal tab; the cockpit is a layout'" "split-window -v -c '#{pane_current_path}' ; set -p @moa_label '⌨ shell'"
bind -T moa m       select-window -t moa:moa
bind -T moa z       resize-pane -Z
bind -T moa [       previous-window
bind -T moa ]       next-window
bind -T moa a       send-keys C-a
bind -r -T moa Left  select-pane -L
bind -r -T moa Right select-pane -R
bind -r -T moa Up    select-pane -U
bind -r -T moa Down  select-pane -D
bind -T moa h        select-pane -L
bind -T moa l        select-pane -R
bind -T moa k        select-pane -U
bind -T moa j        select-pane -D
# The full menu: Space, a second Ctrl-a, and tmux's own prefix (Ctrl-b) Space, so that
# doesn't fall back to next-layout and scramble the cockpit.
bind -T moa Space   display-menu -T "#[align=centre fg=#88c0d0 bold] moa " -x C -y C \
  "Console" c 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key console - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Sessions tree" t 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key tree - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Big picture" p 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key plan - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Agent spot" g 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key agent - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Find a session…" / 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key find - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "New session…" n 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key new - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Terminal here" '$' 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key terminal - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Split: shell beside" '|' 'if -F '\''#{==:#{window_name},moa}'\'' '\''display "split an agent or terminal tab; the cockpit is a layout"'\'' '\''split-window -h -c "##{pane_current_path}" ; set -p @moa_label "⌨ shell"'\''' \
  "Split: shell below" - 'if -F '\''#{==:#{window_name},moa}'\'' '\''display "split an agent or terminal tab; the cockpit is a layout"'\'' '\''split-window -v -c "##{pane_current_path}" ; set -p @moa_label "⌨ shell"'\''' \
  "Back to moa" m 'select-window -t moa:moa' \
  "Zoom in/out" z 'resize-pane -Z' \
  "" \
  "Layout: cockpit" 1 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key layout-1 - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Layout: focus (agent)" 2 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key layout-2 - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Layout: classic" 3 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key layout-3 - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Layout: triage (status)" 4 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key layout-4 - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Repair panels" r 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key repair - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "" \
  "-Ctrl-a ←↑↓→  move between splits" '' '' \
  "Previous tab" '[' previous-window \
  "Next tab" ']' next-window \
  "Keys and help" '?' 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key help - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Send Ctrl-a to the app" a 'send-keys C-a'
bind -T moa C-a     display-menu -T "#[align=centre fg=#88c0d0 bold] moa " -x C -y C \
  "Console" c 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key console - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Sessions tree" t 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key tree - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Big picture" p 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key plan - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Agent spot" g 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key agent - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Find a session…" / 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key find - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "New session…" n 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key new - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Terminal here" '$' 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key terminal - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Split: shell beside" '|' 'if -F '\''#{==:#{window_name},moa}'\'' '\''display "split an agent or terminal tab; the cockpit is a layout"'\'' '\''split-window -h -c "##{pane_current_path}" ; set -p @moa_label "⌨ shell"'\''' \
  "Split: shell below" - 'if -F '\''#{==:#{window_name},moa}'\'' '\''display "split an agent or terminal tab; the cockpit is a layout"'\'' '\''split-window -v -c "##{pane_current_path}" ; set -p @moa_label "⌨ shell"'\''' \
  "Back to moa" m 'select-window -t moa:moa' \
  "Zoom in/out" z 'resize-pane -Z' \
  "" \
  "Layout: cockpit" 1 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key layout-1 - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Layout: focus (agent)" 2 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key layout-2 - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Layout: classic" 3 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key layout-3 - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Layout: triage (status)" 4 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key layout-4 - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Repair panels" r 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key repair - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "" \
  "-Ctrl-a ←↑↓→  move between splits" '' '' \
  "Previous tab" '[' previous-window \
  "Next tab" ']' next-window \
  "Keys and help" '?' 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key help - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Send Ctrl-a to the app" a 'send-keys C-a'
bind Space display-menu -T "#[align=centre fg=#88c0d0 bold] moa " -x C -y C \
  "Console" c 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key console - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Sessions tree" t 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key tree - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Big picture" p 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key plan - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Agent spot" g 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key agent - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Find a session…" / 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key find - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "New session…" n 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key new - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Terminal here" '$' 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key terminal - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Split: shell beside" '|' 'if -F '\''#{==:#{window_name},moa}'\'' '\''display "split an agent or terminal tab; the cockpit is a layout"'\'' '\''split-window -h -c "##{pane_current_path}" ; set -p @moa_label "⌨ shell"'\''' \
  "Split: shell below" - 'if -F '\''#{==:#{window_name},moa}'\'' '\''display "split an agent or terminal tab; the cockpit is a layout"'\'' '\''split-window -v -c "##{pane_current_path}" ; set -p @moa_label "⌨ shell"'\''' \
  "Back to moa" m 'select-window -t moa:moa' \
  "Zoom in/out" z 'resize-pane -Z' \
  "" \
  "Layout: cockpit" 1 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key layout-1 - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Layout: focus (agent)" 2 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key layout-2 - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Layout: classic" 3 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key layout-3 - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Layout: triage (status)" 4 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key layout-4 - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Repair panels" r 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key repair - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "" \
  "-Ctrl-a ←↑↓→  move between splits" '' '' \
  "Previous tab" '[' previous-window \
  "Next tab" ']' next-window \
  "Keys and help" '?' 'if -F '\''#{@moa_ctl}'\'' { run -C "display-message -c '\''#{@moa_ctl}'\'' '\''moa:key help - ##{session_id} ##{client_name}'\''" } { display-message -d 4000 "moa isn'\''t running: run moa" }' \
  "Send Ctrl-a to the app" a 'send-keys C-a'
bind m select-window -t moa:moa
bind C if -F '#{@moa_ctl}' { run -C "display-message -c '#{@moa_ctl}' 'moa:key repair - ##{session_id} ##{client_name}'" } { display-message -d 4000 "moa isn't running: run moa" }
