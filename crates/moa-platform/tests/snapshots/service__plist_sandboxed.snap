---
source: crates/moa-platform/tests/service.rs
expression: plist(&sandbox)
---
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>moa.daemon.work</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/moa bin/moa&amp;co</string>
		<string>daemon</string>
		<string>--brain</string>
		<string>work</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Adaptive</string>
	<key>StandardErrorPath</key>
	<string>/r/.local/state/moa/logs/work.stderr.log</string>
</dict>
</plist>
