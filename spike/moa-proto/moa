#!/bin/bash
# THROWAWAY PROTOTYPE launcher: the moa cockpit (a layout of panels) in window 0,
# agent sessions in their own windows, all on a private tmux server (-L moa).
#   moa                      the default (private) brain
#   moa work                 another brain: its own moa, server (-L moa-work) and brain.db
#   moa work --account A     ...and moa runs on account A, which new sessions default to
#                            (saved in ~/.config/moa/work.env; default.env for the default)
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
chat="$here/../master-chat"
brain="" account=""
while [ $# -gt 0 ]; do
  case "$1" in
    --account) account="${2:?--account needs an account, like claude-lead}"; account="${account/#\~/$HOME}"; shift 2 ;;
    -h|--help) sed -n '4,7s/^# //p' "$0"; exit 0 ;;
    -*) echo "moa: unknown option $1 (moa --help)" >&2; exit 2 ;;
    *) [ -z "$brain" ] || { echo "moa: one brain at a time" >&2; exit 2; }; brain="$1"; shift ;;
  esac
done
[[ -z "$brain" || "$brain" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "moa: a brain's name is lowercase letters, digits and dashes" >&2; exit 2; }
[ "$brain" != default ] || { echo "moa: plain moa is the default brain" >&2; exit 2; }  # default.env is its settings file
# Run from inside another moa (a terminal pane), this shell carries that moa's settings
# and a session's markers; none of them belong to this brain. Its settings file has them.
unset MOA_ACCOUNT MOA_OPEN_ACCOUNT MOA_TRACK MOA_TITLE MOA_GROUP MOA_SELF
# Set every MOA_ variable here, before the tmux server starts: the server keeps this
# environment, so its panels, key bindings and every session it opens use this brain,
# even when this was run from inside another brain's moa.
. "$here/brain.sh"
moa_brain "$brain"
conf="$HOME/.config/moa/${brain:-default}.env"
if [ -n "$account" ]; then
  mkdir -p "$(dirname "$conf")"
  { grep -v '^MOA_ACCOUNT=\|^MOA_OPEN_ACCOUNT=' "$conf" 2>/dev/null || true
    printf 'MOA_ACCOUNT=%q\nMOA_OPEN_ACCOUNT=%q\n' "$account" "$account"; } >"$conf.tmp"
  mv "$conf.tmp" "$conf"
fi
if [ -f "$conf" ]; then set -a; . "$conf"; set +a; fi
if [ -z "$brain" ]; then
  [ -f "$MOA_DB" ] || "$chat/seed.sh"
else
  if [ ! -f "$MOA_DB" ]; then
    mkdir -p "$(dirname "$MOA_DB")"
    sqlite3 "$MOA_DB" <"$chat/schema.sql" >/dev/null
    echo "moa: a new brain, $MOA_DB"
  fi
  if [ ! -f "$MOA_SCOPE" ]; then
    mkdir -p "$(dirname "$MOA_SCOPE")"
    sed "s/{{BRAIN}}/$brain/g" "$chat/scope-template.md" >"$MOA_SCOPE"
    echo "moa: what this moa is for is in $MOA_SCOPE; edit it any time"
  fi
  [ -n "${MOA_ACCOUNT:-}" ] || echo "moa: moa runs on claude-lead; moa $brain --account NAME picks another" >&2
fi
T=(tmux -L "$MOA_TMUX" -f "$here/tmux.conf")
if ! "${T[@]}" has-session -t moa 2>/dev/null; then
  # A placeholder window; `moactl layout apply` builds the current cockpit layout
  # (~/.config/moa/layouts.json) in its place.
  "${T[@]}" new-session -d -s moa -n moa -x "$(tput cols)" -y "$(tput lines)" "sleep 2147483647"
  # A broken layouts.json must not leave a blank cockpit: fall back to the console alone.
  if ! "$here/moactl" layout apply >/dev/null; then
    "${T[@]}" respawn-pane -k -t moa:moa "python3 '$here/console.py' 2>>'$here/console.err'"
    "${T[@]}" set -p -t moa:moa @moa_panel console \; set -p -t moa:moa @moa_label "◆ moa" \; set -p -t moa:moa @moa_framed 1 \; set -p -t moa:moa window-style fg=#4c566a \; set -p -t moa:moa window-active-style fg=#88c0d0
  fi
elif [ -n "$account" ]; then
  # already running: new sessions pick the account up now; moa itself the next time it starts
  "${T[@]}" set-environment -g MOA_ACCOUNT "$account" \; set-environment -g MOA_OPEN_ACCOUNT "$account"
  echo "moa: new sessions open on $account now; moa itself moves to it the next time its console starts" >&2
fi
if [ -n "${TMUX:-}" ]; then  # tmux inside tmux, both on Ctrl-a, is a trap: hand it to a new terminal
  echo "moa: the ${brain:-default} moa is running; open it from a new terminal tab: moa${brain:+ $brain}"
  exit 0
fi
exec "${T[@]}" attach -t moa
