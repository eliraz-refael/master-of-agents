#!/bin/bash
# THROWAWAY PROTOTYPE launcher: the moa cockpit (a layout of panels) in window 0,
# agent sessions in their own windows, all on a private tmux server (-L moa).
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
chat="$here/../master-chat"
T=(tmux -L moa -f "$here/tmux.conf")
[ -f "$chat/brain.db" ] || "$chat/seed.sh"
if ! "${T[@]}" has-session -t moa 2>/dev/null; then
  # A placeholder window; `moactl layout apply` builds the current cockpit layout
  # (~/.config/moa/layouts.json) in its place.
  "${T[@]}" new-session -d -s moa -n moa -x "$(tput cols)" -y "$(tput lines)" "sleep 2147483647"
  "$here/moactl" layout apply >/dev/null
fi
exec "${T[@]}" attach -t moa
