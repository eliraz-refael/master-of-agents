#!/bin/bash
# THROWAWAY PROTOTYPE: moactl for agents, on their PATH through the moa plugin (a plugin's
# bin/ is). It runs the repo's moactl. On an account moa only follows in some folders
# (MOA_ONLY_UNDER, which `moactl setup only` writes into that account's settings), moa is
# off for sessions elsewhere, e.g. day-job work on a shared account: a guard against
# accidents, checked against the folder the session started in.
here="$(dirname "$(realpath "$0")")"
if [ -n "${MOA_ONLY_UNDER:-}" ]; then
  dir="${CLAUDE_PROJECT_DIR:-$PWD}"; ok=""; IFS=: read -ra roots <<<"$MOA_ONLY_UNDER"
  for r in "${roots[@]}"; do
    [ -n "$r" ] || continue
    case "$dir/" in "${r%/}"/*) ok=1; break ;; esac
  done
  if [ -z "$ok" ]; then
    echo "moa isn't available here: on this account it only works in ${MOA_ONLY_UNDER//:/, }." >&2
    exit 1
  fi
fi
exec "$here/../../../moa-proto/moactl" "$@"
