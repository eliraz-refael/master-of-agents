#!/bin/bash
# THROWAWAY PROTOTYPE: moactl for agents, on their PATH through the moa plugin (a plugin's
# bin/ is). It runs the repo's moactl, for the moa this session belongs to. Some accounts
# say where that is (`moactl setup` writes it into the account's settings env), checked
# against the folder the session started in:
# - MOA_ACCOUNT_BRAIN: that brain's moa, except under MOA_EXCEPT_UNDER (the moa that
#   started the session, the default one when none did).
# - MOA_ONLY_UNDER: moa only works in those folders, e.g. to keep day-job work on a shared
#   account away from it; a guard against accidents.
# CLAUDE_PROJECT_DIR isn't in the agent's shell, and $PWD follows its `cd`s, so the start
# folder is Claude's own cwd.
here="$(dirname "$(realpath "$0")")"
. "$here/../../../moa-proto/brain.sh"
if [ -n "${MOA_ACCOUNT_BRAIN:-}${MOA_ONLY_UNDER:-}" ]; then
  dir="${CLAUDE_PROJECT_DIR:-}"
  [ -n "$dir" ] || [ -z "${CLAUDE_PID:-}" ] || dir="$(lsof -a -p "$CLAUDE_PID" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p')"
  dir="${dir:-$PWD}"
  if [ -n "${MOA_ACCOUNT_BRAIN:-}" ]; then
    if ! moa_under "$dir" "${MOA_EXCEPT_UNDER:-}"; then
      moa_brain "$MOA_ACCOUNT_BRAIN"
      [ -f "$MOA_DB" ] || { echo "the $MOA_ACCOUNT_BRAIN moa has no brain yet: start it once with moa $MOA_ACCOUNT_BRAIN" >&2; exit 1; }
    fi
  elif ! moa_under "$dir" "$MOA_ONLY_UNDER"; then
    echo "moa isn't available here: on this account it only works in ${MOA_ONLY_UNDER//:/, }." >&2
    exit 1
  fi
fi
exec "$here/../../../moa-proto/moactl" "$@"
